// Semantic colors for Airbnb-style redesign
$text-primary: #1a1a1a;
$text-secondary: #6a6a6a;
$text-tertiary: #767676;

$bg-page: #f7f7f7;
$bg-surface: #fff;
$bg-tag: $neutral-200;
$bg-tag-active: #1a1a1a;

$text-tag: #444;
$text-tag-active: #fff;

$divider: #ebebeb;

$primary-text-safe: $primary-700;

$shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.06);
$shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
$shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.12);

$bg-bubble-me: $primary-text-safe;
$bg-bubble-theirs: #f0f0f0;

$border-default: #ddd;
